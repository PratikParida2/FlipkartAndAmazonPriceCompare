{
    "manifest_version": 3,
    "name": "Flipkart Amazon Price Checker",
    "version": "1.0",
    "description": "Compare Flipkart product prices with Amazon.",
    "permissions": ["scripting", "tabs", "activeTab"],
    "host_permissions": ["https://www.flipkart.com/*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://www.flipkart.com/*"],
        "js": ["content.js"]
      }
    ],
    "icons": {
      "128": "icon.png"
    }
  }